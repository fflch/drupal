<?php

/**
 * @file
 * Install, update and uninstall functions for the fflch installation profile.
 */

use Drupal\user\Entity\User;
use Drupal\user\UserInterface;

/**
 * Implements hook_install().
 *
 * Perform actions to set up the site for this profile.
 *
 * @see system_install()
 */
function fflchprofile_install() {

  // Define que o registro de visitantes requer aprovação administrativa
  $user_settings = \Drupal::configFactory()->getEditable('user.settings');
  $user_settings->set('register', UserInterface::REGISTER_VISITORS_ADMINISTRATIVE_APPROVAL)->save(TRUE);

  // Atribui ao usuário 1 (root) a função de "administrator" utilizando a API de entidades
  $user = User::load(1);
  if ($user) {
    $user->addRole('administrator');
    $user->save();
  }

  // Ativa o tema de administração para edição de conteúdo
  \Drupal::configFactory()->getEditable('node.settings')->set('use_admin_theme', TRUE)->save(TRUE);

  // Instala módulos customizados em um único lote
  \Drupal::service('module_installer')->install([
    'fflch_configs',
    'fflch_fakecontent',
  ], TRUE);

  // Desinstala o módulo "update" caso esteja ativo
  \Drupal::service('module_installer')->uninstall(['update'], TRUE);
}